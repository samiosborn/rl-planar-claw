<!-- assets/claw.urdf -->
<robot name="planar_claw" version="1.0">


    <!-- Link colours -->

    <material name="link_1_colour">
        <color rgba="0.20 0.45 0.90 1"/>
    </material>

    <material name="link_2_colour">
        <color rgba="0.20 0.75 0.35 1"/>
    </material>

    <material name="link_3_colour">
        <color rgba="0.95 0.55 0.20 1"/>
    </material>


    <!-- Both fingers of the claw have the same fixed base -->
    <link name="base_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="1.0"
                ixy="0.0"
                ixz="0.0"
                iyy="1.0"
                iyz="0.0"
                izz="1.0"/>
        </inertial>
    </link>


    <!-- Left finger -->
    <!-- All joints rotate about world x; links hang downward (-z) from the base -->

    <joint name="left_joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="left_link_1"/>
        <origin xyz="0 -0.03 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="left_link_1">
        <visual>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
            <material name="link_1_colour"/>
        </visual>

        <collision>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 -0.045"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.0000425"
                ixy="0"
                ixz="0"
                iyy="0.0000425"
                iyz="0"
                izz="0.000004"/>
        </inertial>
    </link>

    <joint name="left_joint_2" type="revolute">
        <parent link="left_link_1"/>
        <child link="left_link_2"/>
        <origin xyz="0 0 -0.09"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="left_link_2">
        <visual>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
            <material name="link_2_colour"/>
        </visual>

        <collision>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 -0.045"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.0000425"
                ixy="0"
                ixz="0"
                iyy="0.0000425"
                iyz="0"
                izz="0.000004"/>
        </inertial>
    </link>

    <joint name="left_joint_3" type="revolute">
        <parent link="left_link_2"/>
        <child link="left_link_3"/>
        <origin xyz="0 0 -0.09"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="left_link_3">
        <visual>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
            <material name="link_3_colour"/>
        </visual>

        <collision>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 -0.045"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.0000425"
                ixy="0"
                ixz="0"
                iyy="0.0000425"
                iyz="0"
                izz="0.000004"/>
        </inertial>
    </link>


    <!-- Right finger (mirror of left, offset +y) -->

    <joint name="right_joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="right_link_1"/>
        <origin xyz="0 0.03 0"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="right_link_1">
        <visual>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
            <material name="link_1_colour"/>
        </visual>

        <collision>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 -0.045"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.0000425"
                ixy="0"
                ixz="0"
                iyy="0.0000425"
                iyz="0"
                izz="0.000004"/>
        </inertial>
    </link>

    <joint name="right_joint_2" type="revolute">
        <parent link="right_link_1"/>
        <child link="right_link_2"/>
        <origin xyz="0 0 -0.09"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="right_link_2">
        <visual>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
            <material name="link_2_colour"/>
        </visual>

        <collision>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 -0.045"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.0000425"
                ixy="0"
                ixz="0"
                iyy="0.0000425"
                iyz="0"
                izz="0.000004"/>
        </inertial>
    </link>

    <joint name="right_joint_3" type="revolute">
        <parent link="right_link_2"/>
        <child link="right_link_3"/>
        <origin xyz="0 0 -0.09"/>
        <axis xyz="1 0 0"/>
        <limit lower="-1.5708" upper="1.5708" effort="2" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="right_link_3">
        <visual>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
            <material name="link_3_colour"/>
        </visual>

        <collision>
            <origin xyz="0 0 -0.045"/>
            <geometry>
                <box size="0.02 0.02 0.09"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 -0.045"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.0000425"
                ixy="0"
                ixz="0"
                iyy="0.0000425"
                iyz="0"
                izz="0.000004"/>
        </inertial>
    </link>

</robot>
