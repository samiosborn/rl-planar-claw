<!-- claw.urdf -->
<robot name="planar_claw" version="1.2">

    <!-- Link colours -->
    <material name="link_1_colour">
        <color rgba="0.20 0.45 0.90 1"/>
    </material>

    <material name="link_2_colour">
        <color rgba="0.20 0.75 0.35 1"/>
    </material>

    <material name="link_3_colour">
        <color rgba="0.95 0.55 0.20 1"/>
    </material>

    <!-- Both fingers of the claw have the same fixed base -->
    <link name="base_link"/>

    <!-- Left finger -->

    <joint name="left_joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="left_link_1"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="left_link_1">
        <visual>
            <origin xyz="-0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
            <material name="link_1_colour"/>
        </visual>

        <collision>
            <origin xyz="-0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.05 0 0"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.000004"
                ixy="0"
                ixz="0"
                iyy="0.000052"
                iyz="0"
                izz="0.000052"/>
        </inertial>
    </link>

    <joint name="left_joint_2" type="revolute">
        <parent link="left_link_1"/>
        <child link="left_link_2"/>
        <origin xyz="-0.10 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="left_link_2">
        <visual>
            <origin xyz="-0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
            <material name="link_2_colour"/>
        </visual>

        <collision>
            <origin xyz="-0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.05 0 0"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.000004"
                ixy="0"
                ixz="0"
                iyy="0.000052"
                iyz="0"
                izz="0.000052"/>
        </inertial>
    </link>

    <joint name="left_joint_3" type="revolute">
        <parent link="left_link_2"/>
        <child link="left_link_3"/>
        <origin xyz="-0.10 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="left_link_3">
        <visual>
            <origin xyz="-0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
            <material name="link_3_colour"/>
        </visual>

        <collision>
            <origin xyz="-0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="-0.05 0 0"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.000004"
                ixy="0"
                ixz="0"
                iyy="0.000052"
                iyz="0"
                izz="0.000052"/>
        </inertial>
    </link>

    <!-- Right finger -->

    <joint name="right_joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="right_link_1"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="right_link_1">
        <visual>
            <origin xyz="0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
            <material name="link_1_colour"/>
        </visual>

        <collision>
            <origin xyz="0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.05 0 0"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.000004"
                ixy="0"
                ixz="0"
                iyy="0.000052"
                iyz="0"
                izz="0.000052"/>
        </inertial>
    </link>

    <joint name="right_joint_2" type="revolute">
        <parent link="right_link_1"/>
        <child link="right_link_2"/>
        <origin xyz="0.10 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="right_link_2">
        <visual>
            <origin xyz="0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
            <material name="link_2_colour"/>
        </visual>

        <collision>
            <origin xyz="0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.05 0 0"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.000004"
                ixy="0"
                ixz="0"
                iyy="0.000052"
                iyz="0"
                izz="0.000052"/>
        </inertial>
    </link>

    <joint name="right_joint_3" type="revolute">
        <parent link="right_link_2"/>
        <child link="right_link_3"/>
        <origin xyz="0.10 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="10" velocity="2"/>
        <dynamics damping="0.0" friction="0.0"/>
    </joint>

    <link name="right_link_3">
        <visual>
            <origin xyz="0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
            <material name="link_3_colour"/>
        </visual>

        <collision>
            <origin xyz="0.05 0 0"/>
            <geometry>
                <box size="0.10 0.02 0.02"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0.05 0 0"/>
            <mass value="0.06"/>
            <inertia
                ixx="0.000004"
                ixy="0"
                ixz="0"
                iyy="0.000052"
                iyz="0"
                izz="0.000052"/>
        </inertial>
    </link>

</robot>