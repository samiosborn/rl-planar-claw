<!-- assets/plane.urdf -->
<robot name="plane" version="1.0">

    <link name="plane_link">

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.0"/>
            <inertia
                ixx="1.0"
                ixy="0.0"
                ixz="0.0"
                iyy="1.0"
                iyz="0.0"
                izz="1.0"/>
        </inertial>

        <visual>
            <origin xyz="0 0 -0.01"/>
            <geometry>
                <box size="1.0 1.0 0.02"/>
            </geometry>
            <material name="plane_colour">
                <color rgba="0.65 0.65 0.65 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 -0.01"/>
            <geometry>
                <box size="1.0 1.0 0.02"/>
            </geometry>
        </collision>

    </link>

</robot>